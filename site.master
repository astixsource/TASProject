<%@ Master Language="VB" CodeFile="site.master.vb"  Inherits="site" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title><%= ConfigurationManager.AppSettings("Title").ToString().Trim()%></title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />

    <link href="StylesTreeView/Css/main.css" rel="stylesheet" type="text/css" />
    <%--<link href="CSS/InternalMain.css" rel="stylesheet" type="text/css" />--%>
    <script src="Scripts/jquery-1.10.2.js" type="text/javascript"></script>
    <script src="StylesTreeView/js/custom-script.js" type="text/javascript"></script>
    <script src="scripts/BootStrap/bootstrap.min.js"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
        
    </asp:ContentPlaceHolder>
    <style>
        .blink-one {
         animation: blinker-one 1s linear infinite;
       }
       @keyframes blinker-one {  
         0% { opacity: 0; }
       }
    </style>
</head>
<body oncontextmenu="return false;">
    <form id="form1" runat="server">
    <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true">
    </asp:ScriptManager>
        <script type="text/javascript">
            function preventBack() { window.history.forward(); }
            setTimeout("preventBack()", 0);
            window.onunload = function () { null };
        </script>
        <script language="javascript" type="text/javascript">
            window.onload = function () {
                KeepSessionAlive();
                setInterval("KeepSessionAlive()", 60000)
            }

            function KeepSessionAlive() {
                // <a href="../../KeepSessionAlive.ashx">../KeepSessionAlive.ashx</a>
                var url = "../KeepSessionAlive.ashx?";
                $.ajax({
                    type: "GET",
                    url: url,
                    success: function (msg) {
                        document.title = "TAS";
                        $("#divOnline")[0].innerHTML = "";
                    },
                    error: function (XMLHttpRequest, textStatus, errorThrown) {
                        //document.title = "You are offline : TAS";
                        //$("#divOnline")[0].innerHTML = "Network Status : <font style='color:red;font-weight:bold' class='blink-one'>You are offline</font>";
                    }
                });
            }
        </script>
    <script language="javascript" type="text/javascript">
        function fnClose() {
            window.close();
        }

        function fnLogout() {
            var virtualPath = '<%= System.Configuration.ConfigurationManager.AppSettings("VirtualPath").ToString().Trim() %>';
            window.location.href = "../frmLogout.aspx";
        }

        function fnHelpLine() {
            var valHelpline = 1
            //window.open("HelpLine.htm?valHelpline=" + valHelpline)
        }



    </script>
    <script language="javascript" type="text/javascript">
        var widthBool = 0
        function fnsetFrameWidth() {
            if (widthBool == 0) {
                widthBool = 1
                document.getElementById("tdShowHide").innerHTML = "&gt;&gt;"
                parent.frames["fset"].cols = "10%,90%"
            }
            else {
                widthBool = 0
                document.getElementById("tdShowHide").innerHTML = "&lt;&lt;"
                parent.frames["fset"].cols = "20%,80%"
            }
        }

        $(document).ready(function () {
            //$("#dvtree").css("height", $(window).height() - parseInt("20") - ($("#dvBanner").height() + $("#dvFooter").height() + $(".leftMenu-headding").height()) + "px");
            $("#dvtree").css("height", "460px");
            $(".mainpanel").css("height", $(window).height() - ($("#dvBanner").height() + $("#dvFooter").height()) + "px");
            $("#dLabel").click(function () {
                $('.dropdown-menu').toggle();
            })
            $("body").click(function (e) {
                if ($(e.target).is('#dLabel,#spnbtn, .dropdown-menu *')) return;
                $(".dropdown-menu").css("display", "none");
            });

        });

        function fnChangePass() {
            window.location.href = 'frmChangepasswordfirsttime.aspx';
        }
    </script>
    <div>
        <div id="dvBanner" style="position:fixed;top:0;width:100%; z-index:99">
            <!---------// header section start here //------------>
            <div id="header">
                <div class="L_header">
                    <asp:Image ID="imgLogo" runat="server" ImageUrl="~/NewImages/astix_logo.png" />
                </div>
                <div class="C_header">
                </div>
                <div class="R_header">
                    <asp:Image ID="Image1" runat="server" />
                    <div style="display: inline;float:right" class="text-center" id="divOnline">
                                
                            </div>
                </div>
                <div class="clear">
                </div>
            </div>
            <!---------// Logout_bar section start here //------------>
            <div id="Logout_bar">
                <div class="pull-left dropdown">
                    <button id="dLabel" type="button" class="btn btn-secondary" style="background-color:#6c757d;color:#ffffff"  data-toggle="tooltip" aria-haspopup="true" aria-expanded="false">
   <span class="glyphicon glyphicon-menu-hamburger"  id="spnbtn" ></span>
   
  </button>
                    <div class="dropdown-menu" aria-labelledby="dLabel" style="min-width:257px">
                         <asp:ContentPlaceHolder ID="cphLeft" runat="server">
                </asp:ContentPlaceHolder>
  </div>
                    
                </div>
                 
                <div class="B_right1">
                    <span runat="server" id="spanUserName" style="float:left;padding:6px 15px;font-weight:bold;color:#ffffff">
                    
                        </span>
                     <asp:LinkButton ID="lnkChangepassword" runat="server" class="button1" style="cursor: pointer;" title="Change Password" OnClick="lnkChangepassword_Click">Change Password</asp:LinkButton>
                                   &nbsp;
                    <a onclick="fnLogout()" style="cursor: pointer" class="button1">Logout</a>&nbsp;
                </div>
                <div class="clear">
                </div>
            </div>
        </div>
        <!--Left Sections Start Here-->
        <div class="conatnt container" style="margin-top:0 !important">
          <%--  <div class="leftpanel">
               
                <!-- ERROR MESSAGE -->
                <input id="hdnRspId" type="hidden" value="0" runat="server" name="hdnRspId">
                <div class="menutoggle" title='Expand / Collapse Menu'>
                </div>
            </div>--%>
            <!--Right Sections Start Here-->
          <%--  <div class="mainpanel" style='position:static;margin-top:4px !important'>--%>
                <asp:ContentPlaceHolder ID="cphRight" runat="server">
                </asp:ContentPlaceHolder>
                <div class="clear">
                </div>
            <%--</div>--%>
        </div>
        <!--<div id="dvFooter">
        </div>-->
    </div>
